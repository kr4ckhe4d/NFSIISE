From 19a8dde81a1f1a519d37b429703232e4c54bd8f0 Mon Sep 17 00:00:00 2001
From: Nipuna H Herath <nipunaherath@hotmail.com>
Date: Sat, 7 Nov 2026 17:41:11 +0800
Subject: [PATCH] Widescreen: scale X projection of full-width views by
 widescreenScale

The wrapper sets widescreenScale = (4/3) / screen aspect, so a wider
horizontal field of view fits into the game's 640x480 screen space and the
wrapper stretches it back to the real aspect ratio (Hor+).

Patched in the float projection setup (sub_433910), the fixed-point
projection setup (sub_4A05C8) and the zoomed projection path. Only views
with full 640 width are affected (not the rear-view mirror).
---
 NFS2SE.asm | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/NFS2SE.asm b/NFS2SE.asm
index 4ffe323..c5f2396 100644
--- a/NFS2SE.asm
+++ b/NFS2SE.asm
@@ -16,6 +16,7 @@ global mousePositionY
 global inControlAssignMode
 
 extern SDL_NumJoysticks_wrap
+extern widescreenScale
 extern SDL_GetTicks_wrap
 extern SDL_Delay_wrap
 
@@ -63817,6 +63818,12 @@ loc_4339AE:
 	mov edx, [ebp+24h]
 	fstp dword [dword_4D5294]
 	fstp dword [flt_4D5298]
+	cmp dword [ebp+1Ch], 44200000h ; widescreen: squeeze X projection when width == 640.0
+	jnz loc_ws_c
+	fld dword [dword_4D5294]
+	fmul dword [widescreenScale]
+	fstp dword [dword_4D5294]
+loc_ws_c:
 	test edx, edx
 	jnz loc_433A26
 	mov esp, ebp
@@ -100571,6 +100578,12 @@ loc_44DD72:
 	mov edx, dword [dword_4DAC10]
 	imul edx, esi
 	mov dword [dword_4DAC24], eax
+	cmp dword [dword_4DAC0C], 140h ; widescreen: squeeze X projection of full-width views
+	jnz loc_ws_b
+	fild dword [dword_4DAC24]
+	fmul dword [widescreenScale]
+	fistp dword [dword_4DAC24]
+loc_ws_b:
 	mov eax, edx
 	sar edx, 1Fh
 	idiv ecx
@@ -100596,6 +100609,11 @@ loc_44DD72:
 	fxch st1
 	fstp dword [dword_4D5294]
 	fstp dword [flt_4D5298]
+	cmp dword [flt_4D52A4], 43A00000h ; widescreen: half width == 320.0
+	jnz loc_44DE48
+	fld dword [dword_4D5294]
+	fmul dword [widescreenScale]
+	fstp dword [dword_4D5294]
 
 loc_44DE48:
 	mov eax, ebp
@@ -204480,6 +204498,12 @@ sub_4A05C8: ;SUBROUTINE
 	sar edx, 1Fh
 	idiv ecx
 	mov dword [dword_4DAC24], eax
+	cmp dword [dword_4DAC0C], 140h ; widescreen: squeeze X projection of full-width views
+	jnz loc_ws_a
+	fild dword [dword_4DAC24]
+	fmul dword [widescreenScale]
+	fistp dword [dword_4DAC24]
+loc_ws_a:
 	test esi, esi
 	jz loc_4A06CF
 	mov eax, dword [dword_4DAC34]
-- 
